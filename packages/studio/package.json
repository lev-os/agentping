{
    "name": "@agentping/studio",
    "version": "0.1.0",
    "description": "AgentPing Studio - Bi-directional MCP Canvas with Claude Code Integration",
    "type": "commonjs",
    "main": "dist/main/index.js",
    "scripts": {
        "predev": "lsof -ti:5180,5181,5182,5183,5184,5185,5186,5187,5188,7890 | xargs kill -9 2>/dev/null || true",
        "start": "electron .",
        "dev": "vite",
        "dev:web": "vite",
        "dev:electron": "npm run dev:vite & npm run dev:electron:app",
        "dev:electron:app": "wait-on http://localhost:5180 && tsc -p tsconfig.main.json && electron .",
        "typecheck": "tsc --noEmit",
        "build": "tsc -p tsconfig.main.json && vite build && electron-builder",
        "build:mac": "npm run build -- --mac",
        "build:win": "npm run build -- --win",
        "preview": "vite preview",
        "clean": "rm -rf dist out",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug"
    },
    "dependencies": {
        "@kingly/ui": "workspace:*",
        "@agentping/core": "workspace:*",
        "@agentping/http-api": "workspace:*",
        "@agentping/storage-sqlite": "workspace:*",
        "@anthropic-ai/claude-agent-sdk": "^0.2.15",
        "@hono/node-server": "^1.4.1",
        "@modelcontextprotocol/sdk": "^1.0.0",
        "clsx": "^2.1.1",
        "dashboard-runner": "link:../dashboard-runner",
        "@lev-os/dashboard-manager-server": "workspace:*",
        "electron-store": "^8.1.0",
        "electron-updater": "^6.7.3",
        "fabric": "^6.0.0",
        "highlight.js": "^11.11.1",
        "lucide-react": "^0.562.0",
        "nanoid": "3",
        "node-pty": "^1.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.0",
        "recharts": "^2.15.0",
        "xterm": "^5.3.0",
        "xterm-addon-fit": "^0.8.0",
        "xterm-addon-search": "^0.13.0",
        "xterm-addon-web-links": "^0.9.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@storybook/addon-essentials": "^8.5.0",
        "@storybook/addon-interactions": "^8.5.0",
        "@storybook/addon-links": "^8.5.0",
        "@storybook/blocks": "^8.5.0",
        "@storybook/react": "^8.5.0",
        "@storybook/react-vite": "^8.5.0",
        "@storybook/test": "^8.5.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^4.2.0",
        "electron": "28.3.3",
        "electron-builder": "^24.9.0",
        "electron-rebuild": "^3.2.9",
        "storybook": "^8.5.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "com.kingly.agentping-studio",
        "productName": "AgentPing Studio",
        "directories": {
            "output": "out"
        },
        "files": [
            "dist/**/*"
        ],
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ]
        }
    }
}
