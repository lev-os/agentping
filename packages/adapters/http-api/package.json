{
    "name": "@agentping/http-api",
    "version": "0.1.0",
    "description": "HTTP API adapter for AgentPing",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./websocket": {
            "import": "./dist/websocket.js",
            "require": "./dist/websocket.js",
            "types": "./dist/websocket.d.ts"
        },
        "./dist/websocket.js": {
            "import": "./dist/websocket.js",
            "require": "./dist/websocket.js",
            "types": "./dist/websocket.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@agentping/core": "workspace:*",
        "hono": "^4.0.0",
        "@hono/node-server": "^1.4.0",
        "ws": "^8.16.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@types/ws": "^8.5.10",
        "typescript": "^5.3.0",
        "vitest": "^1.0.0"
    }
}