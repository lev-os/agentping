{
  "name": "@agentping/browser-extension",
  "version": "0.1.0",
  "description": "AgentPing Chrome extension - CDP bridge to daemon via WebSocket",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "watch": "wxt build --mode development && chokidar 'entrypoints/**/*' 'public/**/*' -c 'wxt build --mode development'",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.3.0",
    "wxt": "^0.20.0"
  }
}
