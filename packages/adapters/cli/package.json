{
    "name": "@agentping/cli",
    "version": "0.1.0",
    "description": "CLI tool for AgentPing",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "agentping": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc",
