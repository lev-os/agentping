        "ink-select-input": "^5.0.0",
        "ink-spinner": "^5.0.0",
        "ink-text-input": "^6.0.0",
        "ora": "^8.0.0",
        "react": "^18.2.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
