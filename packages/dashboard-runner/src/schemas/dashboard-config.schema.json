{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dashboard Configuration Schema",
  "description": "JSON Schema for validating dashboards.yaml configuration",
  "type": "object",
  "required": ["dashboards"],
  "properties": {
    "dashboards": {
      "type": "array",
      "description": "List of dashboard configurations",
      "items": {
        "$ref": "#/definitions/DashboardConfig"
      }
    }
  },
  "definitions": {
    "DashboardConfig": {
      "type": "object",
      "required": ["name", "id", "port", "port_range", "command", "cwd"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable name for the dashboard",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "description": "Unique identifier for the dashboard",
          "pattern": "^[a-z0-9-]+$"
        },
        "port": {
          "type": "integer",
          "description": "Default port to run the dashboard on",
          "minimum": 1024,
          "maximum": 65535
        },
        "port_range": {
          "type": "array",
          "description": "Range of ports to try if default is unavailable",
          "items": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "minItems": 2,
          "maxItems": 2
        },
        "command": {
          "type": "string",
          "description": "Command to run the dashboard (use {port} placeholder)",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "description": "Working directory to run the command from",
          "minLength": 1
        },
        "health_check": {
          "$ref": "#/definitions/HealthCheckConfig"
        },
        "restart_policy": {
          "$ref": "#/definitions/RestartPolicyConfig"
        },
        "env": {
          "type": "object",
          "description": "Environment variables to set for the dashboard process",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "HealthCheckConfig": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["http", "process"],
          "description": "Type of health check to perform"
        },
        "path": {
          "type": "string",
          "description": "HTTP path for health check (required for http type)"
        },
        "timeout_ms": {
          "type": "integer",
          "description": "Timeout in milliseconds for health check",
          "minimum": 100,
          "default": 5000
        },
        "expected_status": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              }
            }
          ],
          "description": "Expected HTTP status code(s)"
        },
        "interval_ms": {
          "type": "integer",
          "description": "Interval between health checks in milliseconds",
          "minimum": 1000,
          "default": 10000
        }
      }
    },
    "RestartPolicyConfig": {
      "type": "object",
      "required": ["enabled", "max_retries", "backoff_ms"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether to enable automatic restarts"
        },
        "max_retries": {
          "type": "integer",
          "description": "Maximum number of restart attempts",
          "minimum": 0
        },
        "backoff_ms": {
          "type": "array",
          "description": "Exponential backoff delays in milliseconds",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        }
      }
    }
  }
}
