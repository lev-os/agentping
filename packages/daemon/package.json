{
    "name": "@agentping/daemon",
    "version": "0.1.0",
    "description": "AgentPing daemon - wires everything together",
    "type": "module",
    "main": "dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./config": "./dist/config.js",
        "./config-schema": "./dist/config-schema.js",
        "./xdg-paths": "./dist/xdg-paths.js"
    },
    "bin": {
        "agentping-daemon": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@agentping/core": "workspace:*",
        "@agentping/storage-sqlite": "workspace:*",
        "@agentping/http-api": "workspace:*",
        "@hono/node-server": "^1.4.0",
        "ws": "^8.16.0",
        "yaml": "^2.3.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/ws": "^8.5.10",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0",
        "vitest": "^3.0.0"
    }
}