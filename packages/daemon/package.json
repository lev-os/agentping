        "@agentping/http-api": "workspace:*",
        "@hono/node-server": "^1.4.0",
        "ws": "^8.16.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/ws": "^8.5.10",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}