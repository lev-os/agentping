{
  "name": "@lev-os/dashboard-manager-server",
  "version": "0.1.0",
  "description": "HTTP server for dashboard-runner with REST API and WebSocket support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dashboard-manager-server": "./dist/cli.js",
    "dashboard-cli": "./dist/cli-manage.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./cli-manage": {
      "import": "./dist/cli-manage.js",
      "types": "./dist/cli-manage.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../dashboard-runner build && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lev-os/dashboard-runner": "workspace:*",
    "hono": "^4.0.0",
    "@hono/node-server": "^1.4.0",
    "socket.io": "^4.7.0",
    "yaml": "^2.3.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "dashboard",
    "http-server",
    "websocket",
    "api",
    "monitoring"
  ],
  "author": "Leviathan Team",
  "license": "MIT"
}
